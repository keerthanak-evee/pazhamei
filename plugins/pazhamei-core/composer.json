{
	"name": "pazhamei/pazhamei-core",
	"description": "Business logic for the Pazhamei cloud kitchen.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=8.1"
	},
	"require-dev": {
		"phpunit/phpunit": "^10.5"
	},
	"autoload-dev": {
		"psr-4": {
			"Pazhamei\\": "includes/",
			"Pazhamei\\Tests\\": "tests/"
		}
	},
	"scripts": {
		"test": "phpunit"
	},
	"config": {
		"sort-packages": true
	}
}
