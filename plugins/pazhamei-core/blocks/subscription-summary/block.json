	"textdomain": "pazhamei-core",
	"supports": {
		"html": false,
		"multiple": false,
		"interactivity": true,
		"align": [ "wide" ],
		"spacing": { "margin": true, "padding": true }
	},
	"editorScript": "file:./editor.js",
	"viewScriptModule": "pz-dashboard",
	"style": [ "pz-portal", "file:./style.css" ],
	"render": "file:./render.php"
}
