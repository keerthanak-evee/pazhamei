{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "pz/subscription-summary",
	"version": "0.4.0",
	"title": "Subscription summary",
	"category": "widgets",
	"icon": "id",
